{
  "name": "returndesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.js",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:reset": "node --env-file-if-exists=.env.local scripts/db-reset.js",
    "test": "vitest run tests/unit",
    "test:api": "vitest run tests/api",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "vitest": "^5.0.5"
  }
}
