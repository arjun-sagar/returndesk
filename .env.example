# PostgreSQL connection string used by the app, migrations and seed scripts. Server-side only.
# Local (Homebrew PostgreSQL):  postgresql://returndesk:CHANGE_ME@localhost:5432/returndesk_dev
# Hosted (Neon, pooled):        postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_URL=postgresql://returndesk:CHANGE_ME@localhost:5432/returndesk_dev

# Base URL of a running ReturnDesk server, used only by `npm run test:api`. Optional.
TEST_BASE_URL=http://localhost:3000
